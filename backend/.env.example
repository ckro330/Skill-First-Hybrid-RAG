# LLM defaults
# Supported providers: zhipu, bailian, deepseek, openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=

# DeepSeek
DEEPSEEK_API_KEY=your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Embedding defaults
# Supported providers: local, zhipu, bailian, openai
# local = sentence-transformers 本地模型，无需 API key
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# OpenAI embeddings
OPENAI_API_KEY=your_key
OPENAI_BASE_URL=https://api.openai.com/v1

# Tavily web search
TAVILY_API_KEY=your_key
TAVILY_PROJECT=

# Skill Router L2 retrieval（未设置 EMBEDDING_MODEL 时，本地知识库向量检索也复用该模型）
SKILL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# SKILL_ROUTE_THRESHOLD=0.30

# PostgreSQL + pgvector（长期记忆 MemoryManager）
# 不配置时长期记忆自动降级为空，Agent 主链路不受影响
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skill_first_rag
# 向量维度需与 EMBEDDING_MODEL 输出维度一致（bge-small-zh-v1.5 = 512）
MEMORY_EMBEDDING_DIMENSION=512
# 当前无用户体系，长期记忆使用占位用户 id
MEMORY_DEFAULT_USER_ID=default
